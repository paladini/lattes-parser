{
  "name": "@paladini/lattes-toolkit",
  "version": "2.11.1",
  "description": "Toolkit to edit exported Currículo Lattes XML programmatically, via CLI or automated AI agents. Independent project for the platform XML format. Not affiliated with CNPq.",
  "bin": {
    "lattes-toolkit": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./extrator": {
      "types": "./dist/extrator/index.d.ts",
      "import": "./dist/extrator/index.js",
      "require": "./dist/extrator/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "DEFINITIONS/xml_cvbase_src_main_resources_CurriculoLattes_12_09_2022.xsd"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lattes",
    "lattes-toolkit",
    "cnpq",
    "curriculo",
    "curriculum",
    "xml",
    "parser",
    "extrator",
    "brasil",
    "pesquisa",
    "typescript"
  ],
  "author": "Fernando Paladini <fnpaladini@gmail.com> (https://github.com/paladini)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paladini/lattes-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/paladini/lattes-toolkit/issues"
  },
  "homepage": "https://paladini.github.io/lattes-toolkit/",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.9",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "soap": "^1.1.7"
  },
  "peerDependenciesMeta": {
    "soap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "soap": "^1.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0",
    "vitepress": "^1.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
